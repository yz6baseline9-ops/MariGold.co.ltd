      <p data-template-id="result-ja" class="canva-text ja" style="color: rgb(41, 46, 42);">確認が完了しました。これは試作画面のため、契約・請求・決済は行われていません。</p>
      <p data-template-id="result-en" class="canva-text en" style="color: rgb(41, 46, 42);">Review acknowledged. This is a prototype: no contract, billing, or payment has taken place.</p>
     </div>
    </div>
   </section>
  </div>
  <script>
  const body=document.body, modal=document.getElementById('review-modal'), dialog=modal.querySelector('[role="dialog"]');
  let returnFocus=null;
  function language(lang){
    body.dataset.lang=lang; document.documentElement.lang=lang;
    document.getElementById('lang-ja').setAttribute('aria-pressed',String(lang==='ja'));
    document.getElementById('lang-en').setAttribute('aria-pressed',String(lang==='en'));
    document.querySelectorAll('#payment-method option').forEach(option=>{option.textContent=option.dataset[lang]});
  }
  document.getElementById('lang-ja').addEventListener('click',()=>language('ja'));
  document.getElementById('lang-en').addEventListener('click',()=>language('en'));
  function closeModal(){modal.classList.add('hidden');document.body.style.overflow='';if(returnFocus)returnFocus.focus()}
  document.getElementById('open-review').addEventListener('click',event=>{returnFocus=event.currentTarget;modal.classList.remove('hidden');document.body.style.overflow='hidden';document.getElementById('close-review').focus()});
  document.getElementById('close-review').addEventListener('click',closeModal);
  modal.addEventListener('click',event=>{if(event.target===modal)closeModal()});
  modal.addEventListener('keydown',event=>{
    if(event.key==='Escape'){closeModal();return}
    if(event.key!=='Tab')return;
    const items=[...dialog.querySelectorAll('button:not(:disabled),input:not(:disabled),select:not(:disabled)')];
    if(event.shiftKey&&document.activeElement===items[0]){event.preventDefault();items.at(-1).focus()}
    else if(!event.shiftKey&&document.activeElement===items.at(-1)){event.preventDefault();items[0].focus()}
  });
  document.getElementById('agreement').addEventListener('change',event=>{document.getElementById('confirm-review').disabled=!event.target.checked;document.getElementById('review-result').classList.add('hidden')});
  document.getElementById('confirm-review').addEventListener('click',()=>document.getElementById('review-result').classList.remove('hidden'));
  const toggle=document.getElementById('toggle-writing'),area=document.getElementById('writing-area');
  toggle.addEventListener('click',()=>{
    const opening=area.classList.contains('hidden');area.classList.toggle('hidden',!opening);
    toggle.querySelectorAll('.writing-open').forEach(el=>el.classList.toggle('hidden',opening));
    toggle.querySelectorAll('.writing-close').forEach(el=>el.classList.toggle('hidden',!opening));
    toggle.setAttribute('aria-expanded',String(opening));if(opening)document.getElementById('reflection').focus();
  });
  document.getElementById('print-button').addEventListener('click',()=>window.print());
</script>
 
</body></html>